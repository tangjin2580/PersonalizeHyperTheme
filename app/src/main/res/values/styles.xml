<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- SnowUI typography system -->
    <style name="Theme.PersonalizeHyperTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:colorPrimary">@color/primary_blue</item>
        <item name="android:colorPrimaryDark">@color/primary_purple</item>
        <item name="android:colorAccent">@color/primary_blue</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/primary_blue</item>
        <item name="android:navigationBarColor">@color/white_100</item>
    </style>
    
    <!-- Text styles -->
    <style name="Text.H1">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineHeight">32sp</item>
    </style>
    
    <style name="Text.H2">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineHeight">28sp</item>
    </style>
    
    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    
    <style name="Text.BodyBold">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineHeight">20sp</item>
    </style>
    
    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:lineHeight">16sp</item>
    </style>
    
    <!-- Button styles -->
    <style name="Button.Primary">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:background">@drawable/button_primary_selector</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">88dp</item>
    </style>
    
    <style name="Button.Secondary">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primary_blue</item>
        <item name="android:background">@drawable/button_secondary_selector</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">88dp</item>
    </style>
    
    <!-- Card style -->
    <style name="CardView">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">16dp</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:elevation">2dp</item>
    </style>

</resources>